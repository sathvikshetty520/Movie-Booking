{
  "name": "movie-ticket-booking-backend",
  "version": "1.0.0",
  "description": "Movie Ticket Booking Backend with concurrency control (MVC + PostgreSQL + Redis + Socket.io)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "psql -U $PGUSER -d $PGDATABASE -f sql/schema.sql",
    "seed": "psql -U $PGUSER -d $PGDATABASE -f sql/seed.sql",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "ioredis": "^5.4.1",
    "pg": "^8.11.5",
    "socket.io": "^4.7.5",
    "uuid": "^9.0.1",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.1.4",
    "supertest": "^7.2.2"
  }
}
